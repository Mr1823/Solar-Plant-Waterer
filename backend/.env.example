# Server
PORT=3001
# Origin allowed to open the Socket.IO connection (the Vite dev server in
# development, your deployed dashboard URL in production).
# Unset falls back to '*', which allows any origin.
FRONTEND_URL=http://localhost:5173

# Groq AI
GROQ_API_KEY=gsk_your_api_key_here
# Chat model used for insights. Groq retires models periodically — if the AI
# card goes quiet, check `curl -H "Authorization: Bearer $GROQ_API_KEY" \
# https://api.groq.com/openai/v1/models` and set a current one here.
# The server falls back to other known-good models automatically.
GROQ_MODEL=qwen/qwen3.8-27b


# OpenWeatherMap
OPENWEATHER_API_KEY=your_openweather_api_key_here

# How long to cache weather, in seconds. Shared by every open dashboard, which
# polls every 30 minutes. Free tier allows 60 calls/minute.
WEATHER_CACHE_SECONDS=900

# Database (SQLite file path, relative to backend root)
DB_PATH=./data/solar.db

# ── Supabase Postgres (Prisma) ───────────────────────────────────────────
# Replace [YOUR-PASSWORD] with the database password from
# Supabase → Project Settings → Database. URL-encode any special characters.
#
# Pooled, transaction mode (port 6543) — used by the running app.
DATABASE_URL="postgresql://postgres.psrumbikiszyammagibe:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct, session mode (port 5432) — used by prisma migrate / db pull.
DIRECT_URL="postgresql://postgres.psrumbikiszyammagibe:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"
